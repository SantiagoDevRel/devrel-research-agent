# Authentication: ONE of the following is required.
#
#   (a) If you have Claude Code installed and have run `claude login` with a
#       Pro/Max subscription, the Agent SDK will use those OAuth credentials
#       automatically. You can leave ANTHROPIC_API_KEY empty.
#
#   (b) Otherwise, set ANTHROPIC_API_KEY (pay-per-token billing).
#
ANTHROPIC_API_KEY=

# Optional but recommended (raises GitHub API rate limit from 60 to 5000 req/h)
GITHUB_TOKEN=

# Optional — defaults shown
# DEVREL_RESEARCH_OUT_DIR=./reports
# DEVREL_RESEARCH_LEAD_MODEL=sonnet
# DEVREL_RESEARCH_SUB_MODEL=haiku
# DEVREL_RESEARCH_SYNTH_MODEL=opus
